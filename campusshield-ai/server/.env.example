# Server
PORT=8080

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# If SMTP/Twilio aren't configured, the server can return the OTP for demo/dev.
DEV_RETURN_OTP=true

# --- SMTP (Email OTP) ---
# Recommended: use an SMTP provider (SendGrid/Mailgun/etc) or Gmail App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Twilio Verify (Phone OTP) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
